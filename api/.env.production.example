# ═══ 生产环境配置模板 ═══
# 复制为 .env.production 并填入真实值。部署时用 dotenv -e .env.production 显式注入，
# 不要依赖进程 cwd 下的 .env（当前 .env 是开发配置：NODE_ENV=development +
# DB_SYNCHRONIZE=true，原样上生产会触发 TypeORM 对生产库自动执行全量 DDL）。
#
# 上线必改清单见 AUTH.md。核对完成后删掉本段注释。

NODE_ENV=production

# ── 数据库 ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=blog
DB_PASSWORD=CHANGE_ME
DB_DATABASE=blog-lite
# 生产禁止 synchronize（app.module 启动时也会 fail-fast 拦截）
DB_SYNCHRONIZE=false

# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ── Web ──
PORT=5200
# 生产前端域名（逗号分隔白名单，禁止 *）
CORS_ORIGINS=https://example.com
# 反向代理层数（nginx 在前 = 1）。不配会导致 req.ip 取到代理内网地址，
# IP 限流/黑名单/审计 IP 全部失真
TRUST_PROXY=1
# 请求体上限（默认 10mb，可按需收紧）
# BODY_LIMIT=2mb

# ── 日志 ──
LOG_LEVEL=info

# ── 认证（Casdoor 模式）──
AUTH_PROVIDER=casdoor
CASDOOR_ENDPOINT=https://auth.example.com
CASDOOR_CLIENT_ID=CHANGE_ME
CASDOOR_CLIENT_SECRET=CHANGE_ME
CASDOOR_ORG_NAME=your-org
CASDOOR_APP_NAME=blog-lite
# 本地 token Ed25519 私钥（JWK JSON）。多实例必须共享同一把钥匙
# LOCAL_JWT_PRIVATE_KEY=

# ── 邮件 / R2 / 其余密钥：对照 .env.example 补齐 ──
