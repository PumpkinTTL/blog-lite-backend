# ═══ 生产环境配置模板 ═══
# 复制为 .env.production 并填入真实值。
# 注入方式（二选一）：
#   ① systemd EnvironmentFile=/path/to/.env.production（推荐，见 DEPLOY.md）
#   ② pnpm start:prod:env（bash source 注入）
# 不要依赖进程 cwd 下的开发 .env——生产 + DB_SYNCHRONIZE=true 会被启动 fail-fast 拦截。
# 进程 WorkingDirectory 必须固定为 backend/api（uploads 静态目录与密钥回落文件按 cwd 解析）。
#
# ⚠ 上线前必读：DEPLOY.md 的「上线倒计时」清单。

NODE_ENV=production

# ── 数据库 ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=bloglite
DB_PASSWORD=CHANGE_ME
DB_DATABASE=blog_lite_prod
# 生产禁止 synchronize（app.module 启动 fail-fast 双保险）
DB_SYNCHRONIZE=false
# mysqldump 不在 PATH 时指定绝对路径（备份功能依赖）
# MYSQL_DUMP_BIN=/usr/bin/mysqldump

# ── MySQL 时区对齐（三重时区假设之一）──
# 服务器建议 my.cnf 设 default-time-zone='+08:00'，或全局 SET time_zone='+08:00'

# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ── Web ──
PORT=5200
# 生产前端域名（必须同时含用户站 + admin 站，逗号分隔白名单，禁止 *；协议域名端口逐字精确）
CORS_ORIGINS=https://www.bitlesu.com,https://admin.bitlesu.com
# 反向代理层数（nginx 在前 = 1）。不配则 req.ip 取代理地址，IP 限流/黑名单/审计全部失真
TRUST_PROXY=1
# 请求体上限（默认 10mb；nginx client_max_body_size 必须 ≥ 此值）
# BODY_LIMIT=10mb

# ── 日志 ──
LOG_LEVEL=info

# ── 认证（Casdoor 模式）──
AUTH_PROVIDER=casdoor
CASDOOR_ENDPOINT=https://auth.bitlesu.com
CASDOOR_CLIENT_ID=CHANGE_ME
CASDOOR_CLIENT_SECRET=CHANGE_ME
# 组织名固定 bitle（多应用共享的公司组织，勿照抄旧文档的 blog——代码默认值也是错的）
CASDOOR_ORG_NAME=bitle
CASDOOR_APP_NAME=blog-lite

# ── 本地 token（验证码登录通道）──
# 【必填】Ed25519 私钥 JWK JSON 单行字符串。生成方式见 DEPLOY.md「生成密钥」节。
# 漏配后果：回落 cwd 下 .local-jwt-key.json——重启/换目录会重新生成密钥，
# 验证码登录用户全体掉线；多实例各自持钥互拒签。
LOCAL_JWT_PRIVATE_KEY=
# 本地通道 token TTL（默认即可）
# ACCESS_TOKEN_TTL=7200
# REFRESH_TOKEN_TTL=604800

# ── SMTP 邮件（验证码）──
# 后台设置面板的 SMTP 配置优先；此为面板为空时的兜底。首次部署面板为空 → 不配则发不出验证码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Cloudflare R2（媒体/备份存储）──
# 后台面板的 R2 配置优先；此为兜底。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# ── AI（可选）──
# 后台 AI Provider 面板优先；此为默认 provider 的兜底 key。
# AI_DEFAULT_API_KEY=
# AI_BASE_URL=
# AI_DEFAULT_MODEL=
# TAVILY_API_KEY=
# TAVILY_BASE_URL=
