# ===== blog-lite 后端环境变量 =====
# 复制为 .env 并填入真实值。生产环境 NODE_ENV 必须为 production。

# ===== 运行环境 =====
NODE_ENV=development
PORT=5200
LOG_LEVEL=info
# 信任代理跳数（生产在 nginx 后设 loopback 或具体跳数）
TRUST_PROXY=loopback
# JSON body 上限（富文本/AI 对话需调高）
BODY_LIMIT=10mb

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=bloglite_app
DB_PASSWORD=<强密码-24位以上随机>
DB_DATABASE=blog-lite
# TypeORM 自动建表/改表（生产必须 false！NODE_ENV=production 时会被强制压成 false）
DB_SYNCHRONIZE=true

# ===== Redis（限流/验证码/dashboard 缓存）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<强随机密码>
REDIS_DB=0

# ===== 鉴权中心（外部统一签发/验签 token）=====
AUTH_CENTER_URL=https://auth.bitlesu.com
AUTH_CLIENT_ID=<client-id>
AUTH_CLIENT_SECRET=<client-secret>
# Token TTL（秒）—— ACCESS 由鉴权中心签发，这里用于本地缓存/校验
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

# ===== CORS 白名单（逗号分隔，生产填真实域名）=====
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# ===== SMTP 邮件配置 =====
# 163 邮箱示例（授权码非登录密码，需在邮箱后台开启 SMTP 并生成授权码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-email@163.com
SMTP_PASS=your-authorization-code
SMTP_FROM="观书星" <your-email@163.com>

# ===== Cloudflare R2 对象存储 =====
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=<bucket-name>
R2_PUBLIC_DOMAIN=https://oss.your-domain.com

# ===== AI（Tavily 搜索 + LLM Provider）=====
TAVILY_API_KEY=tvly-prod-<key>
AI_DEFAULT_API_KEY=<llm-api-key>

# ===== 备份（定时任务）=====
BACKUP_ENABLED=true
